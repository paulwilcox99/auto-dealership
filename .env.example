# OpenAI API key for LLM note generation
OPENAI_API_KEY=sk-your-key-here

# Directory where all DB files and state files are written
DB_DIR=./data

# Database driver: sqlite (default) | postgresql
DB_DRIVER=sqlite

# Disable individual workers by setting to "true"
# DISABLE_WORKER_LEAD_CREATION=true
# DISABLE_WORKER_LEAD_PROCESSING=true
# DISABLE_WORKER_SCHEDULE_LEAD=true
# DISABLE_WORKER_WALK_INS=true
# DISABLE_WORKER_SALES_MEETING=true
# DISABLE_WORKER_SALES_FOLLOWUP=true
# DISABLE_WORKER_NEW_CARS=true
# DISABLE_WORKER_FINANCE_SALES=true
# DISABLE_WORKER_FINANCE_PAYMENTS=true
# DISABLE_WORKER_PAYDAY=true
